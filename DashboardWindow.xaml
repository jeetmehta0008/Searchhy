<Window x:Class="Searchhy.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Searchhy — Diagnostic &amp; Control Center"
        Height="680" Width="860"
        MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#0f1117"
        Foreground="#f1f5f9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1e2433"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d3748"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a202c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1d4ed8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60a5fa"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e40af"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Live Monitor & Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Custom Desktop Icon Manager -->
            <RowDefinition Height="Auto"/>
            <!-- Live Event Log -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="#181c27" CornerRadius="12" Padding="18,14" BorderBrush="#262f40" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Searchhy — Diagnostic &amp; Control Center" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                    </StackPanel>
                    <TextBlock Text="Hold Left + Right mouse buttons together or press Ctrl + Shift + L to Circle to Search."
                               Foreground="#94a3b8" FontSize="12.5" Margin="28,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚀 Test Circle to Search" Style="{StaticResource PrimaryButton}" Click="BtnTestOverlay_Click" Margin="0,0,8,0"/>
                    <Button Content="📋 Test Upload" Style="{StaticResource ModernButton}" Click="BtnTestUpload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Hardware State Indicators -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Button Indicator -->
            <Border Grid.Column="0" Margin="0,0,8,0" Background="#181c27" CornerRadius="10" Padding="14" BorderBrush="#262f40" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Left Mouse Button" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="LeftIndicatorDot" Width="12" Height="12" Fill="#ef4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LeftIndicatorText" Text="RELEASED" FontSize="13" FontWeight="Bold" Foreground="#ef4444"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Button Indicator -->
            <Border Grid.Column="1" Margin="4,0,4,0" Background="#181c27" CornerRadius="10" Padding="14" BorderBrush="#262f40" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Right Mouse Button" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="RightIndicatorDot" Width="12" Height="12" Fill="#ef4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RightIndicatorText" Text="RELEASED" FontSize="13" FontWeight="Bold" Foreground="#ef4444"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Chord Trigger Status -->
            <Border Grid.Column="2" Margin="8,0,0,0" Background="#181c27" CornerRadius="10" Padding="14" BorderBrush="#262f40" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Chord Status" Foreground="#94a3b8" FontSize="11.5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="ChordIndicatorDot" Width="12" Height="12" Fill="#64748b" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ChordIndicatorText" Text="LISTENING (Ready)" FontSize="13" FontWeight="Bold" Foreground="#38bdf8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Desktop Icon Customizer Card -->
        <Border Grid.Row="2" Margin="0,0,0,16" Background="#181c27" CornerRadius="10" Padding="16,12" BorderBrush="#262f40" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Preview -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#242b38" BorderBrush="#38bdf8" BorderThickness="1.5" Margin="0,0,14,0">
                    <Image x:Name="IconPreviewImage" Stretch="Uniform" Margin="3"/>
                </Border>

                <!-- Icon Status & Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Desktop Shortcut &amp; App Icon Manager" Foreground="#ffffff" FontSize="13.5" FontWeight="Bold"/>
                    <TextBlock x:Name="IconStatusText" Text="Current icon: Custom Searchhy Logo" Foreground="#94a3b8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Icon Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎨 Change Icon Image..." Style="{StaticResource ModernButton}" Click="BtnChangeIcon_Click" Margin="0,0,8,0"/>
                    <Button Content="🔄 Refresh Desktop Icon" Style="{StaticResource PrimaryButton}" Click="BtnRefreshIcon_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Real-Time Console Log -->
        <Border Grid.Row="3" Background="#131620" CornerRadius="10" Padding="14" BorderBrush="#262f40" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Live Diagnostic Log" Foreground="#ffffff" FontSize="12.5" FontWeight="Bold"/>
                        <TextBlock Text="(Updated in real-time)" Foreground="#64748b" FontSize="11.5" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="Clear Log" HorizontalAlignment="Right" Background="Transparent" Foreground="#94a3b8" BorderThickness="0" Cursor="Hand" Click="BtnClearLog_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="#38bdf8"
                             FontFamily="Consolas"
                             FontSize="11.5"
                             BorderThickness="0"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Shortcut: " Foreground="#64748b" FontSize="12"/>
                <TextBlock Text="Ctrl + Shift + L (Search)  •  Ctrl + Shift + P (Pause)" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Minimize to Tray" Style="{StaticResource ModernButton}" Click="BtnMinimizeToTray_Click" Margin="0,0,8,0"/>
                <Button Content="✕ Exit Searchhy" Style="{StaticResource ModernButton}" Background="#3f1d24" BorderBrush="#7f1d1d" Foreground="#fca5a5" Click="BtnExit_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

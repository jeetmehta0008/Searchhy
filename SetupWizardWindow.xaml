<Window x:Class="Searchhy.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Searchhy — Setup &amp; Onboarding"
        Height="700" Width="880"
        MinHeight="660" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#f8fafc"
        FontFamily="Segoe UI, Inter, Arial"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Primary Action Button with Vibrant Glowing Gradient -->
        <Style x:Key="SetupPrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284c7" Offset="0.0"/>
                        <GradientStop Color="#2563eb" Offset="0.45"/>
                        <GradientStop Color="#7c3aed" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="28,13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="26"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.5"
                                BorderBrush="#93c5fd">
                            <Border.Effect>
                                <DropShadowEffect Color="#3b82f6" BlurRadius="22" ShadowDepth="3" Opacity="0.75"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#f472b6"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563eb" Offset="0.0"/>
                                            <GradientStop Color="#8b5cf6" Offset="0.5"/>
                                            <GradientStop Color="#ec4899" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Vibrant Practice Button -->
        <Style x:Key="SetupSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#e0e7ff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.2"
                                BorderBrush="#38bdf8">
                            <Border.Effect>
                                <DropShadowEffect Color="#0284c7" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563eb"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Outer Window Container with Sleek Luminous Gradient & Glass Glow -->
    <Border CornerRadius="20"
            BorderThickness="1.5"
            Padding="30">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0b1120" Offset="0.0"/>
                <GradientStop Color="#0f172a" Offset="0.4"/>
                <GradientStop Color="#1e1b4b" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#38bdf8" Offset="0.0"/>
                <GradientStop Color="#818cf8" Offset="0.5"/>
                <GradientStop Color="#c084fc" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#0284c7" BlurRadius="36" ShadowDepth="8" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar / Header -->
                <RowDefinition Height="Auto"/>
                <!-- Hero & Intro Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Features & Setup Cards -->
                <RowDefinition Height="*"/>
                <!-- Footer Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Window Header / Drag Area -->
            <Grid Grid.Row="0" Margin="0,0,0,18" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" Background="#1e293b" BorderBrush="#38bdf8" BorderThickness="1.2" Margin="0,0,12,0">
                        <Image x:Name="HeaderLogoImage" Stretch="Uniform" Margin="3"/>
                    </Border>
                    <TextBlock Text="Searchhy Setup &amp; Onboarding" Foreground="#93c5fd" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1e3a8a" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Native Windows 10 / 11" Foreground="#60a5fa" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Close Button -->
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Background="#1e293b"
                        Foreground="#cbd5e1"
                        FontSize="13"
                        FontWeight="Bold"
                        Width="32" Height="32"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="16" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#ef4444"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#f87171"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Hero Section with Clean Brand Logo and Vibrant Gradient Heading -->
            <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="16" Padding="22,18" BorderThickness="1.2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1e293b" Offset="0.0"/>
                        <GradientStop Color="#0f172a" Offset="0.6"/>
                        <GradientStop Color="#1e1b4b" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#38bdf8" Offset="0.0"/>
                        <GradientStop Color="#818cf8" Offset="0.5"/>
                        <GradientStop Color="#ec4899" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#1e293b" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Official Brand Logo Box -->
                    <Border Grid.Column="0" Width="76" Height="76" CornerRadius="20" Background="#ffffff" BorderBrush="#38bdf8" BorderThickness="2" Margin="0,0,22,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#38bdf8" BlurRadius="20" ShadowDepth="3" Opacity="0.8"/>
                        </Border.Effect>
                        <Image x:Name="HeroLogoImage" Stretch="Uniform" Margin="5"/>
                    </Border>

                    <!-- Header Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Welcome to " FontSize="25" FontWeight="Bold" Foreground="#ffffff"/>
                            <TextBlock Text="Searchhy" FontSize="25" FontWeight="ExtraBold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38bdf8" Offset="0.0"/>
                                        <GradientStop Color="#818cf8" Offset="0.5"/>
                                        <GradientStop Color="#f472b6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Border Background="#0284c7" CornerRadius="12" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="✨ v1.0 Ready" Foreground="#ffffff" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="The authentic Circle to Search experience — built natively for your Windows PC."
                                   Foreground="#cbd5e1" FontSize="13.5" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Content: 2 Balanced Columns (Guide + Settings) -->
            <Grid Grid.Row="2" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.88*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: How to Use & Gestures -->
                <Border Grid.Column="0" Margin="0,0,12,0" Background="#131d33" CornerRadius="16" Padding="20" BorderBrush="#25324d" BorderThickness="1.2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="✨ How to Search Anything" Foreground="#f8fafc" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Trigger Method 1: Mouse Chord -->
                            <Border Background="#1a253d" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="#2e4063" BorderThickness="1.2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#0284c7" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🖱️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Mouse Chord (Default)" Foreground="#ffffff" FontSize="13.5" FontWeight="Bold"/>
                                            <Border Background="#0369a1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="Recommended" Foreground="#7dd3fc" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Hold Left + Right mouse buttons together (~30ms) anywhere on your screen." Foreground="#94a3b8" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Trigger Method 2: Global Hotkey -->
                            <Border Background="#1a253d" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" BorderBrush="#2e4063" BorderThickness="1.2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#7c3aed" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="⌨️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Keyboard Shortcut" Foreground="#ffffff" FontSize="13.5" FontWeight="Bold"/>
                                            <Border Background="#5b21b6" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="Ctrl + Shift + L" Foreground="#c4b5fd" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Press anytime to instantly freeze the screen and start circling." Foreground="#94a3b8" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 3: Smart Shape Snapping -->
                            <Border Background="#1a253d" CornerRadius="12" Padding="14,12" Margin="0,0,0,12" BorderBrush="#2e4063" BorderThickness="1.2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#d97706" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Smart AI Snapping" Foreground="#ffffff" FontSize="13.5" FontWeight="Bold"/>
                                        <TextBlock Text="Circle around any logo, image, or text — Searchhy auto-snaps to fit the exact object!" Foreground="#94a3b8" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Practice Button -->
                            <Button Content="✨ Try a Practice Circle Right Now"
                                    Style="{StaticResource SetupSecondaryBtn}"
                                    HorizontalAlignment="Left"
                                    Click="BtnTryTest_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Preferences & Options -->
                <Border Grid.Column="1" Margin="12,0,0,0" Background="#131d33" CornerRadius="16" Padding="20" BorderBrush="#25324d" BorderThickness="1.2">
                    <StackPanel>
                        <TextBlock Text="⚙️ Setup Preferences" Foreground="#f8fafc" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Start with Windows" FontWeight="Bold" Foreground="#ffffff" FontSize="13"/>
                                <TextBlock Text="Runs quietly in tray when PC turns on" FontSize="12" Foreground="#94a3b8"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkDesktopShortcut" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Create Desktop Shortcut" FontWeight="Bold" Foreground="#ffffff" FontSize="13"/>
                                <TextBlock Text="Adds official Searchhy icon to Desktop" FontSize="12" Foreground="#94a3b8"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkSystemTrayNotification" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Show Tray Ready Toast" FontWeight="Bold" Foreground="#ffffff" FontSize="13"/>
                                <TextBlock Text="Quick notification confirming it's active" FontSize="12" Foreground="#94a3b8"/>
                            </StackPanel>
                        </CheckBox>

                        <Separator Background="#25324d" Margin="0,14,0,14"/>

                        <!-- Visual Engine Status Card -->
                        <TextBlock Text="Visual Search Engine" Foreground="#94a3b8" FontSize="12" FontWeight="Bold"/>
                        <Border Background="#1a253d" CornerRadius="10" Padding="12,8" Margin="0,6,0,10" BorderBrush="#0284c7" BorderThickness="1.2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Searchhy Visual AI (Active)" Foreground="#38bdf8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Pause Hotkey Hint -->
                        <Border Background="#1e1b4b" CornerRadius="10" Padding="12,8" BorderBrush="#4338ca" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pause detection anytime with " Foreground="#c7d2fe" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Text="Ctrl+Shift+P" Foreground="#ffffff" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Footer: Status and Main Launch Button -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Searchhy runs quietly in your Windows System Tray." Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Content="🚀  Get Started with Searchhy"
                        Style="{StaticResource SetupPrimaryBtn}"
                        HorizontalAlignment="Right"
                        Click="BtnFinishSetup_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

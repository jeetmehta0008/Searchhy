<Window x:Class="Searchhy.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Searchhy — Setup &amp; Getting Started"
        Height="680" Width="840"
        MinHeight="640" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#0b0d14"
        Foreground="#f1f5f9"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="SetupPrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1a73e8" Offset="0.0"/>
                        <GradientStop Color="#2563eb" Offset="0.5"/>
                        <GradientStop Color="#7c3aed" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.5"
                                BorderBrush="#60a5fa">
                            <Border.Effect>
                                <DropShadowEffect Color="#2563eb" BlurRadius="18" ShadowDepth="2" Opacity="0.6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#f472b6"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563eb" Offset="0.0"/>
                                            <GradientStop Color="#9333ea" Offset="0.5"/>
                                            <GradientStop Color="#db2777" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1a202c"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="#334155">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2d3748"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38bdf8"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Outer Glassmorphic Border -->
    <Border Background="#111420"
            BorderBrush="#2d3748"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar / Header -->
                <RowDefinition Height="Auto"/>
                <!-- Hero & Intro -->
                <RowDefinition Height="Auto"/>
                <!-- Features & Setup Cards -->
                <RowDefinition Height="*"/>
                <!-- Footer Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Window Header / Drag Area -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#1e293b" BorderBrush="#38bdf8" BorderThickness="1" Margin="0,0,10,0">
                        <Image x:Name="HeaderLogoImage" Stretch="Uniform" Margin="2"/>
                    </Border>
                    <TextBlock Text="Searchhy Setup &amp; Onboarding" Foreground="#94a3b8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#64748b" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Hero Section -->
            <Border Grid.Row="1" Margin="0,0,0,20" Background="#181e2e" CornerRadius="14" Padding="20,16" BorderBrush="#2e384d" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="68" Height="68" CornerRadius="16" Background="#242b38" BorderBrush="#38bdf8" BorderThickness="2" Margin="0,0,20,0">
                        <Image x:Name="HeroLogoImage" Stretch="Uniform" Margin="4"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Welcome to " FontSize="22" FontWeight="Bold" Foreground="#ffffff"/>
                            <TextBlock Text="Searchhy" FontSize="22" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38bdf8" Offset="0.0"/>
                                        <GradientStop Color="#818cf8" Offset="0.5"/>
                                        <GradientStop Color="#f472b6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Border Background="#1e3a8a" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0 Ready" Foreground="#60a5fa" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="The authentic Google 'Circle to Search' experience — built natively for your Windows PC."
                                   Foreground="#94a3b8" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area: 2 Columns (How to Use + Preferences) -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: How to Trigger & Features -->
                <Border Grid.Column="0" Margin="0,0,12,0" Background="#151926" CornerRadius="12" Padding="18" BorderBrush="#242c3d" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="✨ How to Search Anything" Foreground="#ffffff" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Trigger Method 1 -->
                            <Border Background="#1a2233" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2c384e" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖱️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Mouse Shortcut (Default)" Foreground="#ffffff" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Hold Left + Right mouse buttons together (~30ms) anywhere on screen." Foreground="#94a3b8" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Trigger Method 2 -->
                            <Border Background="#1a2233" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2c384e" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⌨️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Keyboard Shortcut" Foreground="#ffffff" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Press Ctrl + Shift + L to open Circle to Search instantly." Foreground="#94a3b8" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 3: Smart Snapping -->
                            <Border Background="#1a2233" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2c384e" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎯" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Smart Shape Snapping" Foreground="#ffffff" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Circle around any logo, image, or text — Searchhy auto-snaps to the object!" Foreground="#94a3b8" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive Test Button -->
                            <Button Content="🧪 Try a Quick Test Right Now" Style="{StaticResource SetupSecondaryBtn}" HorizontalAlignment="Left" Click="BtnTryTest_Click" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Preferences & Setup Options -->
                <Border Grid.Column="1" Margin="12,0,0,0" Background="#151926" CornerRadius="12" Padding="18" BorderBrush="#242c3d" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚙️ Setup Preferences" Foreground="#ffffff" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="Runs silently in tray when PC turns on" FontSize="11.5" Foreground="#64748b"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkDesktopShortcut" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="Create Desktop Shortcut" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="Adds official Searchhy icon to Desktop" FontSize="11.5" Foreground="#64748b"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkSystemTrayNotification" Style="{StaticResource ModernCheckBox}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="Show Tray Ready Toast" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="Quick notification confirming it's active" FontSize="11.5" Foreground="#64748b"/>
                            </StackPanel>
                        </CheckBox>

                        <Separator Background="#242c3d" Margin="0,16,0,16"/>

                        <TextBlock Text="Visual Search Engine" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold"/>
                        <Border Background="#1a2233" CornerRadius="8" Padding="10,6" Margin="0,6,0,0" BorderBrush="#2c384e" BorderThickness="1">
                            <TextBlock Text="🌐 Google Lens Visual AI (Active)" Foreground="#38bdf8" FontSize="12.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer: Complete Setup -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Searchhy will run quietly in your Windows System Tray." Foreground="#64748b" FontSize="12"/>
                </StackPanel>
                <Button Content="🚀  Get Started with Searchhy"
                        Style="{StaticResource SetupPrimaryBtn}"
                        HorizontalAlignment="Right"
                        Click="BtnFinishSetup_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

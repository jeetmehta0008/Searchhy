<Window x:Class="Searchhy.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circle to Search"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    <Window.Resources>
        <!-- Corner Handle Style (Google Lens White L-brackets matching Image 2) -->
        <Style x:Key="CornerBracket" TargetType="Path">
            <Setter Property="Stroke" Value="#ffffff"/>
            <Setter Property="StrokeThickness" Value="5.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Stroke" Value="#38bdf8"/>
                    <Setter Property="StrokeThickness" Value="6.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Creative Floating Google Action Button with Shimmer & Spring Hover -->
        <Style x:Key="CreativeGoogleSearchBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1a73e8" Offset="0.0"/>
                        <GradientStop Color="#2563eb" Offset="0.5"/>
                        <GradientStop Color="#7c3aed" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.5"
                                BorderBrush="#60a5fa">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#f472b6"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563eb" Offset="0.0"/>
                                            <GradientStop Color="#9333ea" Offset="0.5"/>
                                            <GradientStop Color="#db2777" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Pill Button (Copy & Close) -->
        <Style x:Key="CreativeSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#242b38"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1.2"
                                BorderBrush="#475569">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1:1 Pixel-Perfect Frozen Desktop Image -->
        <Image x:Name="ScreenImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Dimmed Mask with Cutout -->
        <Path x:Name="DimmedMaskPath" Fill="#75000000" />

        <!-- Freeform Glowing Chromatic Circle Trail (Ultra-smooth 144Hz) -->
        <Path x:Name="DrawingTrailPath"
              StrokeThickness="5"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4285F4" Offset="0.0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.33"/>
                    <GradientStop Color="#EC4899" Offset="0.66"/>
                    <GradientStop Color="#06B6D4" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <!-- Dynamic Overlay Canvas (Croppable Google Bounding Box & Corner Handles) -->
        <Canvas x:Name="OverlayCanvas">
            <!-- Croppable Bounding Box (Shown after circling) -->
            <Border x:Name="SelectionBox"
                    BorderThickness="2.5"
                    CornerRadius="16"
                    Background="#0638bdf8"
                    Visibility="Collapsed"
                    Cursor="SizeAll">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4285F4" Offset="0.0"/>
                        <GradientStop Color="#EC4899" Offset="0.33"/>
                        <GradientStop Color="#FACC15" Offset="0.66"/>
                        <GradientStop Color="#34A853" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <!-- Live Dimension HUD Tag on Box Drag/Resize -->
            <Border x:Name="DimensionTag"
                    Background="#dd0f172a"
                    BorderBrush="#38bdf8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimensionText" Text="0 × 0 px" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
            </Border>

            <!-- 4 White Google Lens Corner Handles (Exact match to Google Lens Image 2) -->
            <!-- Top-Left Corner Handle -->
            <Path x:Name="HandleTopLeft"
                  Style="{StaticResource CornerBracket}"
                  Data="M 0,26 L 0,8 A 8,8 0 0 1 8,0 L 26,0"
                  Visibility="Collapsed"
                  Cursor="SizeNWSE"/>

            <!-- Top-Right Corner Handle -->
            <Path x:Name="HandleTopRight"
                  Style="{StaticResource CornerBracket}"
                  Data="M 0,0 L 18,0 A 8,8 0 0 1 26,8 L 26,26"
                  Visibility="Collapsed"
                  Cursor="SizeNESW"/>

            <!-- Bottom-Left Corner Handle -->
            <Path x:Name="HandleBottomLeft"
                  Style="{StaticResource CornerBracket}"
                  Data="M 0,0 L 0,18 A 8,8 0 0 0 8,26 L 26,26"
                  Visibility="Collapsed"
                  Cursor="SizeNESW"/>

            <!-- Bottom-Right Corner Handle -->
            <Path x:Name="HandleBottomRight"
                  Style="{StaticResource CornerBracket}"
                  Data="M 0,26 L 18,26 A 8,8 0 0 0 26,18 L 26,0"
                  Visibility="Collapsed"
                  Cursor="SizeNWSE"/>

            <!-- Floating Action Bar with Google Search Button -->
            <StackPanel x:Name="FloatingActionsBar"
                        Orientation="Horizontal"
                        Panel.ZIndex="1000"
                        Visibility="Collapsed">
                <!-- Search with Google Lens Button -->
                <Button x:Name="BtnSearchLens"
                        Style="{StaticResource CreativeGoogleSearchBtn}"
                        Click="BtnConfirmSearch_Click"
                        PreviewMouseDown="BtnConfirmSearch_PreviewMouseDown"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SearchIconText" Text="✨" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchLabelText" Text="Search with Google Lens" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Copy Button -->
                <Button x:Name="BtnCopyImage"
                        Style="{StaticResource CreativeSecondaryBtn}"
                        Click="BtnCopyImage_Click"
                        PreviewMouseDown="BtnCopyImage_PreviewMouseDown"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CopyIconText" Text="📋" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CopyLabelText" Text="Copy" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Dismiss Button -->
                <Button Style="{StaticResource CreativeSecondaryBtn}"
                        Click="BtnDismiss_Click"
                        PreviewMouseDown="BtnDismiss_PreviewMouseDown">
                    <TextBlock Text="✕" FontWeight="Bold" FontSize="13" Foreground="#94a3b8"/>
                </Button>
            </StackPanel>
        </Canvas>

        <!-- Top Google Lens HUD Banner -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,22,0,0"
                Background="#F0111827"
                BorderBrush="#374151"
                BorderThickness="1"
                CornerRadius="24"
                Padding="16,8"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 4 Google Colored Dots -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#4285F4" Margin="0,0,3,0"/>
                    <Ellipse Width="7" Height="7" Fill="#EA4335" Margin="0,0,3,0"/>
                    <Ellipse Width="7" Height="7" Fill="#FBBC05" Margin="0,0,3,0"/>
                    <Ellipse Width="7" Height="7" Fill="#34A853"/>
                </StackPanel>

                <TextBlock Text="Google Lens"
                           Foreground="#ffffff"
                           FontSize="13.5"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="— Drag to circle  •  Auto-snaps to shapes  •  [Enter] to Search  •  [ESC] to cancel"
                           Foreground="#94a3b8"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
